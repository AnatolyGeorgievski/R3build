# Unified production kernel configuration
#
# This is the single production fragment used for production profile builds.
# It combines uart-minimal + NAND-probe base guards + production storage/IRQ
# settings in one file.
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_MODULES=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_MESON=y
CONFIG_SMSC_PHY=y
CONFIG_COMPAT=y
CONFIG_OVERLAY_FS=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
# Amlogic AXG/A113D is the only supported arm64 platform.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
CONFIG_ARCH_MESON=y
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set

# The board has four Cortex-A53 cores and 256 MiB of RAM.
CONFIG_NR_CPUS=4
# CONFIG_NUMA is not set
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_PA_BITS_48=y
# CONFIG_ARM64_LPA2 is not set
# CONFIG_ARM64_PTR_AUTH is not set
# CONFIG_ARM64_BTI is not set
# CONFIG_ARM64_MTE is not set
# CONFIG_ARM64_SVE is not set
# CONFIG_ARM64_SME is not set
# CONFIG_ARM64_GCS is not set

# Firmware is Device Tree plus PSCI/SCPI; this board has no ACPI or EFI path.
# CONFIG_ACPI is not set
# CONFIG_EFI is not set
# CONFIG_PARAVIRT is not set
# CONFIG_XEN is not set
# CONFIG_VIRTUALIZATION is not set

# No corresponding bus or controller is described on the control board.
# CONFIG_PCI is not set
# CONFIG_VFIO is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_ATA is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_DRM is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_BT is not set
# CONFIG_CAN is not set
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# AXG uses the GIC-400 (GICv2); later GIC generations are not present.
# CONFIG_ARM_GIC_V3 is not set
# CONFIG_ARM_GIC_V5 is not set

# Keep only the on-board DWMAC and its SMSC LAN8710/LAN8720 PHY.
# CONFIG_NET_VENDOR_ALACRITECH is not set
# CONFIG_NET_VENDOR_AMAZON is not set
# CONFIG_NET_VENDOR_AMD is not set
# CONFIG_NET_VENDOR_AQUANTIA is not set
# CONFIG_NET_VENDOR_ARC is not set
# CONFIG_NET_VENDOR_ASIX is not set
# CONFIG_NET_VENDOR_BROADCOM is not set
# CONFIG_NET_VENDOR_CADENCE is not set
# CONFIG_NET_VENDOR_CAVIUM is not set
# CONFIG_NET_VENDOR_CORTINA is not set
# CONFIG_NET_VENDOR_DAVICOM is not set
# CONFIG_NET_VENDOR_ENGLEDER is not set
# CONFIG_NET_VENDOR_EZCHIP is not set
# CONFIG_NET_VENDOR_FUNGIBLE is not set
# CONFIG_NET_VENDOR_GOOGLE is not set
# CONFIG_NET_VENDOR_HISILICON is not set
# CONFIG_NET_VENDOR_HUAWEI is not set
# CONFIG_NET_VENDOR_I825XX is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_NET_VENDOR_ADI is not set
# CONFIG_NET_VENDOR_LITEX is not set
# CONFIG_NET_VENDOR_MARVELL is not set
# CONFIG_NET_VENDOR_MELLANOX is not set
# CONFIG_NET_VENDOR_META is not set
# CONFIG_NET_VENDOR_MICREL is not set
# CONFIG_NET_VENDOR_MICROCHIP is not set
# CONFIG_NET_VENDOR_MICROSEMI is not set
# CONFIG_NET_VENDOR_MICROSOFT is not set
# CONFIG_NET_VENDOR_NI is not set
# CONFIG_NET_VENDOR_NATSEMI is not set
# CONFIG_NET_VENDOR_NETRONOME is not set
# CONFIG_NET_VENDOR_8390 is not set
# CONFIG_NET_VENDOR_PENSANDO is not set
# CONFIG_NET_VENDOR_QUALCOMM is not set
# CONFIG_NET_VENDOR_RENESAS is not set
# CONFIG_NET_VENDOR_ROCKER is not set
# CONFIG_NET_VENDOR_SAMSUNG is not set
# CONFIG_NET_VENDOR_SEEQ is not set
# CONFIG_NET_VENDOR_SOLARFLARE is not set
# CONFIG_NET_VENDOR_SMSC is not set
# CONFIG_NET_VENDOR_SOCIONEXT is not set
CONFIG_NET_VENDOR_STMICRO=y
# CONFIG_NET_VENDOR_SYNOPSYS is not set
# CONFIG_NET_VENDOR_VERTEXCOM is not set
# CONFIG_NET_VENDOR_VIA is not set
# CONFIG_NET_VENDOR_WANGXUN is not set
# CONFIG_NET_VENDOR_WIZNET is not set
# CONFIG_NET_VENDOR_XILINX is not set
CONFIG_SMSC_PHY=y
# CONFIG_AQUANTIA_PHY is not set
# CONFIG_MARVELL_10G_PHY is not set
# CONFIG_MARVELL_88Q2XXX_PHY is not set
# CONFIG_MICREL_PHY is not set
# CONFIG_MICROSEMI_PHY is not set
# CONFIG_AT803X_PHY is not set
# CONFIG_REALTEK_PHY is not set
# CONFIG_ROCKCHIP_PHY is not set
# CONFIG_DP83867_PHY is not set
# CONFIG_DP83TD510_PHY is not set
# CONFIG_VITESSE_PHY is not set

# Keep the complete defconfig filesystem and software-networking feature set.
# USB storage needs SCSI even though the board has no native SCSI controller.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# On-board AXG USB2 OTG/host controller and common external-device classes.
CONFIG_INPUT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_MESON_G12A=y
# CONFIG_USB_DWC3_OF_SIMPLE is not set
# CONFIG_USB_DWC3_GENERIC_PLAT is not set
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_HID=y
CONFIG_PHY_MESON_GXL_USB2=y
# CONFIG_USB_CONN_GPIO is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_CDNS_SUPPORT is not set
# CONFIG_USB_MUSB_HDRC is not set
# CONFIG_USB_CHIPIDEA is not set
# CONFIG_USB_ISP1760 is not set
# CONFIG_USB_HSIC_USB3503 is not set
# CONFIG_USB_PHY is not set
# CONFIG_NOP_USB_XCEIV is not set
# CONFIG_USB_ULPI is not set
# CONFIG_USB_ULPI_VIEWPORT is not set
# CONFIG_USB_ULPI_BUS is not set
# CONFIG_USB_SNP_CORE is not set
# CONFIG_USB_SNP_UDC_PLAT is not set
# CONFIG_USB_BDC_UDC is not set

# The SoC SD/eMMC controllers remain available for board and expansion use.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MESON_GX=y
# CONFIG_MMC_ARMMMCI is not set
# CONFIG_MMC_STM32_SDMMC is not set
# CONFIG_MMC_SDHCI is not set
# CONFIG_MMC_SPI is not set
# CONFIG_MMC_DW is not set
# CONFIG_MMC_CQHCI is not set
# CONFIG_MMC_HSQ is not set
# CONFIG_MMC_MTK is not set

# Board firmware, clocks, power, reset, pins, interrupt routing, and DVFS.
CONFIG_ARM_SCPI_PROTOCOL=y
CONFIG_ARM_SCPI_CPUFREQ=y
CONFIG_ARM_SCPI_POWER_DOMAIN=y
CONFIG_COMMON_CLK_SCPI=y
CONFIG_COMMON_CLK_AXG=y
# CONFIG_COMMON_CLK_AXG_AUDIO is not set
CONFIG_PLATFORM_MHU=y
CONFIG_MESON_SM=y
CONFIG_MESON_EE_PM_DOMAINS=y
CONFIG_MESON_SECURE_PM_DOMAINS=y
CONFIG_RESET_MESON=y
# CONFIG_RESET_MESON_AUDIO_ARB is not set
CONFIG_PINCTRL_MESON=y
CONFIG_PINCTRL_MESON_AXG=y
CONFIG_MESON_IRQ_GPIO=y
# CONFIG_MESON_CLK_MEASURE is not set
# CONFIG_MESON_CANVAS is not set
# CONFIG_VIDEO_MESON_GE2D is not set
# CONFIG_PHY_MESON_AXG_PCIE is not set

# Drop clock, pinctrl, PHY, reset, and firmware variants for other Meson SoCs.
# CONFIG_COMMON_CLK_GXBB is not set
# CONFIG_COMMON_CLK_C3_PLL is not set
# CONFIG_COMMON_CLK_C3_PERIPHERALS is not set
# CONFIG_COMMON_CLK_G12A is not set
# CONFIG_COMMON_CLK_S4_PLL is not set
# CONFIG_COMMON_CLK_S4_PERIPHERALS is not set
# CONFIG_PINCTRL_MESON_GXBB is not set
# CONFIG_PINCTRL_MESON_GXL is not set
# CONFIG_PINCTRL_MESON_G12A is not set
# CONFIG_PINCTRL_MESON_A1 is not set
# CONFIG_PINCTRL_MESON_S4 is not set
# CONFIG_PINCTRL_AMLOGIC_A4 is not set
# CONFIG_PINCTRL_AMLOGIC_C3 is not set
# CONFIG_PINCTRL_AMLOGIC_T7 is not set
# CONFIG_PHY_MESON8B_USB2 is not set
# CONFIG_PHY_MESON_G12A_MIPI_DPHY_ANALOG is not set
# CONFIG_PHY_MESON_G12A_USB2 is not set
# CONFIG_PHY_MESON_G12A_USB3_PCIE is not set
# CONFIG_PHY_MESON_AXG_MIPI_PCIE_ANALOG is not set
# CONFIG_PHY_MESON_AXG_MIPI_DPHY is not set
# CONFIG_ARM_SCMI_PROTOCOL is not set
# CONFIG_COMMON_CLK_SCMI is not set
# CONFIG_ARM_SCMI_CPUFREQ is not set
# CONFIG_ARM_SCMI_TRANSPORT_MAILBOX is not set
# CONFIG_RESET_SCMI is not set
# CONFIG_REGULATOR_ARM_SCMI is not set
# CONFIG_SENSORS_ARM_SCMI is not set

# Interfaces observed in the vendor DT and on the running control board.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MESON=y
# CONFIG_I2C_DESIGNWARE_PLATFORM is not set
# CONFIG_I2C_DESIGNWARE_CORE is not set
# CONFIG_I2C_RK3X is not set
# CONFIG_I2C_CROS_EC_TUNNEL is not set
# CONFIG_I2C_HID is not set
CONFIG_SPI=y
CONFIG_SPI_MESON_SPICC=y
# CONFIG_SPI_CADENCE_QUADSPI is not set
# CONFIG_SPI_DW is not set
# CONFIG_SPI_DW_MMIO is not set
# CONFIG_SPI_PL022 is not set
CONFIG_PWM=y
CONFIG_PWM_MESON=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_WATCHDOG=y
CONFIG_MESON_GXBB_WATCHDOG=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_SENSORS_ARM_SCPI=y
CONFIG_IIO=y
CONFIG_MESON_SARADC=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_MESON=y
CONFIG_NVMEM=y
CONFIG_NVMEM_MESON_EFUSE=y

# Other built-in platform peripherals selected by the generic arm64 defconfig.
# CONFIG_CPUFREQ_DT is not set
# CONFIG_FSL_EDMA is not set
# CONFIG_MV_XOR_V2 is not set
# CONFIG_PL330_DMA is not set
# CONFIG_QCOM_HIDMA is not set
# CONFIG_SERIAL_8250 is not set
# CONFIG_SERIAL_AMBA_PL011 is not set
# CONFIG_SERIAL_XILINX_PS_UART is not set
# CONFIG_SERIAL_FSL_LPUART is not set
# CONFIG_SERIAL_FSL_LINFLEXUART is not set
# CONFIG_PINCTRL_MAX77620 is not set
# CONFIG_PINCTRL_SINGLE is not set
# CONFIG_GPIO_DWAPB is not set
# CONFIG_GPIO_MB86S7X is not set
# CONFIG_GPIO_PL061 is not set
# CONFIG_GPIO_SYSCON is not set
# CONFIG_GPIO_XGENE is not set
# CONFIG_GPIO_GENERIC_PLATFORM is not set
CONFIG_GPIO_MAX732X=m
CONFIG_GPIO_PCA953X=m
# CONFIG_GPIO_MAX77620 is not set
# CONFIG_GPIO_TPS65219 is not set
# CONFIG_CLK_VEXPRESS_OSC is not set
# CONFIG_COMMON_CLK_RK808 is not set
# CONFIG_COMMON_CLK_CS2000_CP is not set
# CONFIG_COMMON_CLK_S2MPS11 is not set
# CONFIG_COMMON_CLK_XGENE is not set
# CONFIG_COMMON_CLK_PWM is not set
# CONFIG_COMMON_CLK_RS9_PCIE is not set
# CONFIG_COMMON_CLK_VC3 is not set
# CONFIG_COMMON_CLK_VC5 is not set
# CONFIG_PHY_SAMSUNG_USB2 is not set
# CONFIG_ARM_SP805_WATCHDOG is not set
# CONFIG_ARM_SBSA_WATCHDOG is not set
# CONFIG_DW_WATCHDOG is not set
# CONFIG_ARM_SMC_WATCHDOG is not set
# CONFIG_MTD_CFI is not set
# CONFIG_MTD_PHYSMAP is not set
# CONFIG_MTD_DATAFLASH is not set
# CONFIG_MTD_SST25L is not set
# CONFIG_MTD_NAND_DENALI is not set
# CONFIG_MTD_SPI_NOR is not set
CONFIG_RTC_DRV_MESON_VRTC=y
CONFIG_RTC_DRV_DS3232=m
# CONFIG_RTC_DRV_MAX77686 is not set
# CONFIG_RTC_DRV_S5M is not set
# CONFIG_RTC_DRV_CROS_EC is not set
# CONFIG_RTC_DRV_PL031 is not set
# CONFIG_RTC_DRV_IMX_BBM_SCMI is not set
# CONFIG_RTC_DRV_AMLOGIC_A4 is not set
# CONFIG_DEVFREQ_THERMAL is not set
# CONFIG_THERMAL_EMULATION is not set
# CONFIG_HW_RANDOM_VIRTIO is not set
# CONFIG_HW_RANDOM_OPTEE is not set
# CONFIG_HW_RANDOM_TPM is not set
# CONFIG_IOMMU_SUPPORT is not set

# PMIC/MFD/regulator drivers below belong to reference boards for other SoCs.
# Retain only generic fixed/GPIO/PWM regulator support for board expansion.
# CONFIG_MFD_BD9571MWV is not set
# CONFIG_MFD_AXP20X is not set
# CONFIG_MFD_CROS_EC_DEV is not set
# CONFIG_MFD_HI6421_PMIC is not set
# CONFIG_MFD_MAX77620 is not set
# CONFIG_MFD_MT6360 is not set
# CONFIG_MFD_MT6397 is not set
# CONFIG_MFD_RK8XX is not set
# CONFIG_MFD_SEC_CORE is not set
# CONFIG_MFD_TPS65219 is not set
# CONFIG_MFD_ROHM_BD718XX is not set
# CONFIG_MFD_VEXPRESS_SYSREG is not set
# CONFIG_REGULATOR_AXP20X is not set
# CONFIG_REGULATOR_BD718XX is not set
# CONFIG_REGULATOR_BD9571MWV is not set
# CONFIG_REGULATOR_CROS_EC is not set
# CONFIG_REGULATOR_FAN53555 is not set
CONFIG_REGULATOR_GPIO=y
# CONFIG_REGULATOR_HI6421V530 is not set
# CONFIG_REGULATOR_MAX77620 is not set
# CONFIG_REGULATOR_MAX8973 is not set
# CONFIG_REGULATOR_MP8859 is not set
# CONFIG_REGULATOR_MT6357 is not set
# CONFIG_REGULATOR_MT6358 is not set
# CONFIG_REGULATOR_MT6359 is not set
# CONFIG_REGULATOR_MT6360 is not set
# CONFIG_REGULATOR_MT6397 is not set
# CONFIG_REGULATOR_PCA9450 is not set
# CONFIG_REGULATOR_PF8X00 is not set
# CONFIG_REGULATOR_PFUZE100 is not set
CONFIG_REGULATOR_PWM=y
# CONFIG_REGULATOR_QCOM_SPMI is not set
# CONFIG_REGULATOR_RAA215300 is not set
# CONFIG_REGULATOR_RK808 is not set
# CONFIG_REGULATOR_ROHM is not set
# CONFIG_REGULATOR_S2MPS11 is not set
# CONFIG_REGULATOR_TPS65219 is not set

# There is no display connector or framebuffer device on the miner controller.
# CONFIG_VT is not set
# CONFIG_FB is not set
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_MESON=y
CONFIG_LOCALVERSION="-a113d-production"
CONFIG_CMDLINE="init=/init console=ttyAML0,115200n8 earlycon loglevel=4"
CONFIG_CMDLINE_FORCE=y

# Production exposes the live-qualified cdev-v2 IRQ bridge on periphs-banks.
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
# CONFIG_GPIO_SYSFS is not set
CONFIG_GPIOLIB_IRQCHIP=y
CONFIG_IRQ_DOMAIN_HIERARCHY=y
CONFIG_PINCTRL_MESON=y
CONFIG_PINCTRL_MESON_GPIO_IRQ=y
CONFIG_PINCTRL_MESON_AXG=y
CONFIG_MESON_IRQ_GPIO=y

# Production mounts the existing vendor-created nvdata UBI/UBIFS volume.
CONFIG_MTD_UBI=y
# CONFIG_MTD_UBI_FASTMAP is not set
CONFIG_UBIFS_FS=y
CONFIG_UBIFS_FS_LZO=y
CONFIG_UBIFS_FS_ZLIB=y
CONFIG_UBIFS_FS_ZSTD=y
