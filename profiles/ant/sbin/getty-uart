#!/bin/sh
# Ждём узел UART, затем getty. $1 = device name без /dev/ (ttyMSM0)
DEV="${1:-ttyMSM0}"
BAUD="${2:-115200}"
i=0
while [ ! -c "/dev/$DEV" ] && [ "$i" -lt 30 ]; do
  if [ -x /sbin/mdev ]; then /sbin/mdev -s; elif [ -x /bin/busybox ]; then /bin/busybox mdev -s; fi
  /bin/busybox usleep 200000 2>/dev/null || /bin/sleep 1
  i=$((i + 1))
done
if [ ! -c "/dev/$DEV" ]; then
  echo "getty-uart: no /dev/$DEV, fallback console" > /dev/kmsg 2>/dev/null
  exec /sbin/getty -L "$BAUD" console vt100
fi
exec /sbin/getty -L "$BAUD" "$DEV" vt100
